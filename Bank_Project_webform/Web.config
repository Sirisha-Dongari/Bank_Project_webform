<?xml version="1.0"?>

<configuration>

	<connectionStrings>

		<add
		  name="BankDBConnection"
		  connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=userdb;Integrated Security=True"
		  providerName="System.Data.SqlClient" />

	</connectionStrings>

	<system.web>

		<compilation
		  debug="true"
		  targetFramework="4.8" />

		<httpRuntime
		  targetFramework="4.8" />

	</system.web>

</configuration>